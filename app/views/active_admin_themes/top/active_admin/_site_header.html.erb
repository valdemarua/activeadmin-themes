<header class="aat-header">
  <div class="aat-header__brand"><%= title %></div>
  <%= render "active_admin/main_navigation" %>
  <div class="aat-header__tools">
    <%# .dark-mode-toggle is what AA's own JS listens for. %>
    <button type="button" class="dark-mode-toggle aat-header__icon" aria-label="<%= t('active_admin.toggle_dark_mode') %>">
      <svg class="hidden dark:block" width="16" height="16" aria-hidden="true" fill="none" viewBox="0 0 18 20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.509 5.75c0-1.493.394-2.96 1.144-4.25h-.081a8.5 8.5 0 1 0 7.356 12.746A8.5 8.5 0 0 1 8.509 5.75Z"/></svg>
      <svg class="dark:hidden" width="16" height="16" aria-hidden="true" fill="none" viewBox="0 0 20 20"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 3V1m0 18v-2M5.05 5.05 3.636 3.636m12.728 12.728L14.95 14.95M3 10H1m18 0h-2M5.05 14.95l-1.414 1.414M16.364 3.636 14.95 5.05M14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z"/></svg>
    </button>
    <% if current_active_admin_user? %>
      <%= auto_link current_active_admin_user, class: "aat-header__link" %>
      <%= link_to I18n.t("active_admin.logout"), auto_logout_link_path, class: "aat-header__link", data: { method: :delete } %>
    <% end %>
  </div>
</header>
